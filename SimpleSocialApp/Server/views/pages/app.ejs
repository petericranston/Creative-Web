<%- include('../partials/header') %>

<body>
  <h1>For Posting Content</h1>
  <%- include('../partials/nav') %>

  <h4>New Post</h4>
  <form action="/newpost" method="POST">
    <label>Message</label>
    <input type="text" id="message" name="message" />
    <input type="submit" value="post message" />
  </form>

  <h4>Recent Posts</h4>
  <ul id="recent-posts">
    <% posts.forEach(post => { %>
    <li>
      <p>Message: <%= post.message %> by: <%= post.user %></p>
    </li>
    <% }) %>
  </ul>

